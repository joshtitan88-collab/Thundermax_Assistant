#!/usr/bin/env bash
# tmax — single entry point for the ThunderMax tuning assistant.
#
#   Parser (offline, no deps):
#     tmax info <tune.tbw>              validate + metadata
#     tmax compare <old.tbw> <new.tbw>  diff with named-table labels
#     tmax report <tune.tbw> [-o out]   decode-report skeleton
#     tmax scan <folder> [-o out]       index a tune folder
#
#   Table map:
#     tmax bands                        list known table bands
#     tmax classify <a.tbw> <b.tbw>     label a diff by table/category
#     tmax derive <folder>              audit the band map against labeled tunes
#
#   Fix it (offline, deterministic — works with Ollama down):
#     tmax fix "pops on decel and runs hot"   what to change, and why
#     tmax fix --list                         every symptom it can advise on
#     tmax learned <folder> --family <name>   what AutoTune has been learning
#     tmax watch [folder]                     brief me when a new tune lands
#
#   Health:
#     tmax doctor                       check every invariant
#     tmax doctor heal                  repair what is safe to repair
#     tmax geometry <folder>            infer table geometry from labelled pairs
#
#   Assistant (starts Ollama automatically if needed):
#     tmax ask "question"
#     tmax chat
#     tmax analyze <new.tbw> [--baseline old.tbw]
#
#   Housekeeping:
#     tmax verify                       run the test suite
#
# Safe by design: never writes .tbw files.

set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC="$ROOT/src"

ensure_ollama() {
  # user-local install first, then whatever is on PATH
  [ -d "$HOME/.local/ollama/bin" ] && export PATH="$HOME/.local/ollama/bin:$PATH"
  if curl -sf -m 2 http://127.0.0.1:11434/api/version >/dev/null 2>&1; then
    return 0
  fi
  if ! command -v ollama >/dev/null 2>&1; then
    echo "tmax: ollama not installed (expected ~/.local/ollama/bin)" >&2
    return 1
  fi
  echo "tmax: starting ollama server..." >&2
  nohup ollama serve >>"$HOME/.local/state/tmax-ollama.log" 2>&1 &
  for _ in $(seq 1 30); do
    curl -sf -m 2 http://127.0.0.1:11434/api/version >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  echo "tmax: ollama did not come up within 15s (see ~/.local/state/tmax-ollama.log)" >&2
  return 1
}

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
  info|report|compare|scan)
    exec python3 "$SRC/thundermax_parser.py" "$cmd" "$@" ;;
  bands|classify|derive)
    exec python3 "$SRC/table_map.py" "$cmd" "$@" ;;
  ask|chat|analyze)
    mkdir -p "$HOME/.local/state"
    ensure_ollama || exit 1
    exec python3 "$SRC/tune_assistant.py" "$cmd" "$@" ;;
  fix)
    # Deliberately does NOT call ensure_ollama: a rider on the side of the
    # road with a hot engine gets the same deterministic answer every time,
    # and gets it whether or not the LLM is up.
    if [ "${1:-}" = "--list" ]; then
      exec python3 "$SRC/advisor.py" list
    fi
    exec python3 "$SRC/advisor.py" ask "$@" ;;
  learned)
    exec python3 "$SRC/learned_feedback.py" report "$@" ;;
  lineage)
    exec python3 "$SRC/learned_feedback.py" lineage "$@" ;;
  watch)
    exec python3 "$SRC/tune_watcher.py" "$@" ;;
  doctor)
    exec python3 "$SRC/doctor.py" "$@" ;;
  geometry)
    exec python3 "$SRC/axis_infer.py" geometry "$@" ;;
  verify-labels)
    exec python3 "$SRC/axis_infer.py" verify-labels "$@" ;;
  verify)
    exec "$ROOT/scripts/verify.sh" ;;
  help|-h|--help)
    sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)
    echo "tmax: unknown command '$cmd' (try: tmax help)" >&2
    exit 2 ;;
esac
